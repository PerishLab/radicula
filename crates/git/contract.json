    {"input": "R100\u0000old\u0000new\u0000", "count": 1, "path": "new", "previous": "old", "score": 100},
    {"input": "C050\u0000source\u0000copy\u0000", "count": 1, "path": "copy", "previous": "source", "score": 50},
    {"input": "M100\u0000rewritten\u0000", "count": 1, "path": "rewritten", "score": 100},
    {"input": "A\u0000unterminated", "error": true},
    {"input": "A\u0000\u0000", "error": true},
    {"input": "R100\u0000old\u0000", "error": true},
    {"input": "R\u0000old\u0000new\u0000", "error": true},
    {"input": "C101\u0000old\u0000new\u0000", "error": true},
